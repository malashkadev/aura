# Ignore binary executables (whisper sidecar and llama-server in src-tauri/binaries are intentionally tracked)
Aura.exe
*.exe
!src-tauri/binaries/*.exe
!src-tauri/binaries/**/*.exe
!website/*.exe

# Local benchmark/test artifacts (GGUF models are fetched at runtime, never committed)
src-tauri/models-test/

# Ignore node_modules
node_modules/

# Ignore Rust build artifacts
target/

# Ignore local config/databases
*.db
*.db-shm
*.db-wal
.window-state.json
settings.json

# AI-tooling working files (not part of the app)
.claude/
.agents/
.impeccable/
.superdesign/
graphify-out/
.graphifyignore
skills-lock.json
docs/superpowers/
test_out.txt
/Logo DARK.png
DESIGN.md
PRODUCT.md

.vercel
.env*

# Never commit signing private keys
*.key
*.pem
minisign*

.superpowers/
skill-observations/
skill-updates/
tasks/
log.txt
*.log

# Downloaded GPU runtimes (fetched at install time, not committed)
src-tauri/binaries/cuda/
src-tauri/binaries/ggml-cuda.dll
src-tauri/binaries/llm-cpu/
src-tauri/binaries/llm-vulkan/

# Website temporary preview profiles, test scripts, and test screenshots
website/.temp_edge_profile*/
website/.temp_edge_verify*/
website/.temp_edge_preview/
website/screenshot_*.png
website/check_console.cjs
website/take_screenshots.cjs
website/capture_*.cjs
website/verify_*.cjs
website/server.cjs
website/*showcase*.html
website/preview_*.html
website/test_*.html
website/deck-animations-preview.html

