{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Settings window permissions. Secrets remain in the Rust backend.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-check-for-app-update",
    "allow-install-app-update",
    "allow-get-settings",
    "allow-set-settings",
    "allow-set-ui-language",
    "allow-set-provider-key",
    "allow-download-model-command",
    "allow-cancel-model-download",
    "allow-delete-model-command",
    "allow-get-downloaded-models",
    "allow-download-gpu-binaries",
    "allow-delete-gpu-binaries",
    "allow-cancel-gpu-download",
    "allow-check-gpu-downloaded",
    "allow-check-nvidia-runtime-on-path",
    "allow-get-history",
    "allow-clear-history",
    "allow-copy-to-clipboard",
    "allow-open-url",
    "allow-relaunch-app",
    "allow-minimize-window",
    "allow-close-window",
    "allow-start-dragging-command",
    "allow-get-diagnostic-report",
    "allow-get-engine-health",
    "allow-log-frontend-event",
    "allow-start-mic-meter",
    "allow-stop-mic-meter",
    "allow-reprocess-history-text"
  ]
}
